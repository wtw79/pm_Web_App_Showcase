0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"meta":{"date":"2026-08-10","title":"项目架构与技术栈全景","description":"React 18 + Vite 5 + Electron 33 + sql.js 的三层架构：渲染进程、主进程与数据层的职责边界，双入口构建与多宿主兼容。","image":"/images/overview.png","tags":["架构","技术栈"]},"children":[["$","p",null,{"children":["项目采用 ",["$","strong",null,{"children":"React（渲染层）+ Electron（桌面壳）+ SQLite（数据层）"}]," 的三层架构，源码按职责清晰分层："]}],"\n",["$","pre",null,{"className":"language-text","children":["$","code",null,{"className":"language-text","children":"pm/web\n├── electron/          # Electron 主进程（CommonJS）\n│   ├── main.cjs            # 入口：装配层（initDb → registerIpc → 主窗 → 托盘 → 更新）\n│   ├── ipc-hub.cjs         # 集中式 IPC 中转（全部 ipcMain.handle 登记）\n│   ├── db.cjs              # sql.js（纯 WASM SQLite）：kv/targets/media/deal_artifacts 表\n│   ├── window-manager.cjs  # 统一窗口管理（主窗/投屏窗/崩溃恢复/广播）\n│   ├── storage-layout.cjs  # AuctionData 目录树\n│   ├── preload.cjs         # contextBridge 暴露受控 API（contextIsolation）\n│   ├── tray.cjs / updater.cjs / dev-runner.cjs\n├── src/               # React 渲染进程（ESM）\n│   ├── main.jsx / bigscreen.jsx   # 双 HTML 入口（主控台 / 投屏页）\n│   ├── bridge.js       # 多宿主兼容层（Electron / WebView2 / 浏览器）\n│   ├── store/          # Context + useReducer 全局状态\n│   ├── logic/          # 纯业务逻辑：auction.ts（竞价状态机）、formula.ts（公式引擎）\n│   ├── modules/        # 四大视图：Console / Lots / Settings / Reports\n│   └── components/     # 通用组件 + bigscreen 投屏组件族\n└── vite.config.js      # 双入口构建，base './'，单一 dist\n"}]}],"\n",["$","h2",null,{"children":"技术选型"}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"依赖"}],["$","th",null,{"children":"版本"}],["$","th",null,{"children":"选型理由"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"React"}],["$","td",null,{"children":"18.3"}],["$","td",null,{"children":"组件化 UI，生态成熟"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Vite"}],["$","td",null,{"children":"5.4"}],["$","td",null,{"children":"双 HTML 入口构建，秒级 HMR"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Electron"}],["$","td",null,{"children":"33"}],["$","td",null,{"children":"桌面能力（多屏投屏、本地文件、托盘、自动更新）"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"sql.js"}],["$","td",null,{"children":"1.14"}],["$","td",null,{"children":"纯 WASM SQLite，免 native 重编译，asarUnpack 后可访问"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"SheetJS (xlsx)"}],["$","td",null,{"children":"0.18"}],["$","td",null,{"children":"Excel 导入导出（13 列模板闭环）"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"pdfjs-dist"}],["$","td",null,{"children":"6.2"}],["$","td",null,{"children":"投屏页 PDF canvas 纯净渲染"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Vitest"}],["$","td",null,{"children":"4.x"}],["$","td",null,{"children":"88 个自动化测试用例"}]]}]]}]]}],"\n",["$","h2",null,{"children":"核心架构原则"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"主进程权威态"}],"：",["$","code",null,{"children":"ipc-hub.cjs"}]," 持有 ",["$","code",null,{"children":"canonicalState"}],"，控制台 ",["$","code",null,{"children":"push-state"}]," → 落库 + 广播，投屏窗只读订阅；"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"窗口间通信一律经主进程中转"}],"：",["$","code",null,{"children":"broadcastToDisplays"}]," 统一广播，投屏窗崩溃自动重启（≤3 次）；"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"三宿主兼容"}],"：",["$","code",null,{"children":"bridge.js"}]," 统一抽象 Electron / WebView2 / 纯浏览器，方法名刻意一致（",["$","code",null,{"children":"LoadState"}]," / ",["$","code",null,{"children":"OpenProjection"}]," / ",["$","code",null,{"children":"PickFile"}],"…），浏览器端自动降级 localStorage + window.open；"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"双入口构建"}],"：",["$","code",null,{"children":"index.html"}],"（主控台）+ ",["$","code",null,{"children":"bigscreen.html"}],"（投屏页）独立打包，互不干扰。"]}],"\n"]}]]}],[["$","script","script-0",{"src":"/pm_Web_App_Showcase/_next/static/ch