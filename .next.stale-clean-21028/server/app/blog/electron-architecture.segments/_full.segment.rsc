a:["$","p",null,{"children":["config 是小负载且变化频繁（主题、字号）。如果与整份 state 共用 300ms 防抖落盘通道，副屏要等 300ms 才响应。因此 config 单独走 ",["$","code",null,{"children":"push-config"}],"（50ms 防抖，仅内存广播不落盘），实现副屏\"即改即现\"，整库持久化仍由防抖的 ",["$","code",null,{"children":"push-state"}]," 负责。"]}]
b:["$","h2",null,{"children":"投屏窗崩溃自动恢复"}]
c:["$","p",null,{"children":["现场最怕\"黑屏干等\"。监听 ",["$","code",null,{"children":"render-process-gone"}]," 后 600ms 自动重建投屏窗（最多 3 次），连续崩溃则回发 ",["$","code",null,{"children":"display-crashed"}]," 通知控制台。窗口管理器统一登记所有窗口，创建 / 销毁 / 恢复集中管理。"]}]
d:["$","h2",null,{"children":"sql.js：纯 WASM 的 SQLite"}]
e:["$","p",null,{"children":["选型 ",["$","code",null,{"children":"sql.js"}]," 而非 ",["$","code",null,{"children":"better-sqlite3"}],"：纯 WASM 无需 native 重编译，",["$","code",null,{"children":"asarUnpack"}]," 确保 WASM 文件在打包后可访问。代价是需手动 ",["$","code",null,{"children":"flush()"}]," 落盘——本项目主进程单写者模型天然满足。表结构为 ",["$","code",null,{"children":"kv"}],"（键值）+ ",["$","code",null,{"children":"targets"}],"（标的 JSON）+ ",["$","code",null,{"children":"media"}]," / ",["$","code",null,{"children":"deal_artifacts"}],"（台账），增量 upsert + prune 兜底清理孤儿行。"]}]
f:["$","h2",null,{"children":"三宿主兼容"}]
10:["$","p",null,{"children":[["$","code",null,{"children":"bridge.js"}]," 统一抽象 Electron / WebView2 / 纯浏览器三种宿主，方法名刻意保持一致（",["$","code",null,{"children":"LoadState"}]," / ",["$","code",null,{"children":"OpenProjection"}]," / ",["$","code",null,{"children":"PickFile"}],"…），业务代码完全感知不到运行环境——同一份前端，桌面端用真投屏与 SQLite，浏览器端自动降级为 ",["$","code",null,{"children":"window.open"}]," 与 localStorage。"]}]
