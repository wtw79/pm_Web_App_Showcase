0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"meta":{"date":"2026-08-18","title":"竞价状态机：未开始 → 进行中 → 成交 / 流拍","description":"报价记录的三态语义（领先 / 出局 / 成交）、增价与减价两种拍卖方式、删除任意行的精确撤销栈，以及成交前的二次校验兜底。","image":"/images/console-light.png","tags":["业务逻辑","状态机"]},"children":[["$","p",null,{"children":"竞价核心逻辑按拍卖行业标准流程严谨实现。一个标的的生命周期是一条清晰的状态机："}],"\n",["$","pre",null,{"className":"language-text","children":["$","code",null,{"className":"language-text","children":"未开始 → 进行中（isBeginPaiMai）→ 暂停（isPaused）\n                                → 已成交（isClosed + 成交）\n                                → 流拍（isClosed + 流拍）\n"}]}],"\n",["$","h2",null,{"children":"报价记录三态"}],"\n",["$","p",null,{"children":["每条报价记录 ",["$","code",null,{"children":"{ round, d1, d2, d3, d4..d8 }"}],"，其中 ",["$","code",null,{"children":"d1"}]," 是状态、",["$","code",null,{"children":"d2"}]," 是号牌、",["$","code",null,{"children":"d3"}]," 是金额。",["$","code",null,{"children":"records"}]," 数组",["$","strong",null,{"children":"最新在前"}],"，",["$","code",null,{"children":"records[0]"}]," 恒为当前领先："]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"领先"}],"：当前最高价（进行中，多笔同价并列均领先）"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"出局"}],"：被更高价超越"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"成交"}],"：确认成交后锁定唯一一笔"]}],"\n"]}],"\n",["$","p",null,{"children":["渲染报表 / 控制台时按规则",["$","strong",null,{"children":"重算"}],"每条记录状态，修复了历史数据 ",["$","code",null,{"children":"d1"}]," 残留导致\"轮次 3 还领先\"的 bug——状态永远由数据推导，不信任持久化字段。"]}],"\n",["$","h2",null,{"children":"防错设计"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"报价校验"}],"：号牌纯数字、价格有效、增价不低于起拍价、减价不高于起拍价"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"撤回上一手"}],"：",["$","code",null,{"children":"records.shift()"}],"，次席自动晋升领先"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"删除任意行可撤销"}],"：删除时压入 ",["$","code",null,{"children":"deletedRows"}]," 撤销栈 ",["$","code",null,{"children":"{ record, index }"}],"，可精确还原到原位置与领先状态"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"重新开始带快照"}],"：清空前保存 ",["$","code",null,{"children":"restartSnapshot"}],"，可随时恢复"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"成交前二次校验"}],"：确认成交时再次执行 ",["$","code",null,{"children":"validatePriceRules"}]," 复核领先记录，非法数据进不了归档"]}],"\n"]}],"\n",["$","h2",null,{"children":"增价与减价"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"auctionMode"}]," 为 ",["$","code",null,{"children":"1"}]," 是增价（每手至少加一个幅度），",["$","code",null,{"children":"-1"}]," 是减价（荷兰式，每手往下减）。校验方向、下一手建议价计算（",["$","code",null,{"children":"基准 + 幅度 × 方向"}],"）、大屏\"增价幅度 / 减价幅度\"标签都随模式切换，与原版行为一致。"]}]]}],[["$","script","script-0",{"src":"/pm_Web_App_Showcase/_next/static/chunks/0z70cwjft0ocr.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"pEVCHcpdQDD1gkrVW2f9J"}
