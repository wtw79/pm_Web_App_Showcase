{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/projection-rendering/layout,_N_T_/blog/projection-rendering/page,_N_T_/blog/projection-rendering"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/projection-rendering/__PAGE__",
    "/blog/projection-rendering",
    "/blog",
    "/_index",
    "/_head"
  ]
}